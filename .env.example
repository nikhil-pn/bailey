# Bailey — environment layout. Copy to .env (gitignored) and fill in. Never commit keys.

# Circle developer console (https://console.circle.com)
CIRCLE_API_KEY=
# Generated locally + registered via registerEntitySecretCiphertext (recovery file -> .circle/)
CIRCLE_ENTITY_SECRET=

# AI bookkeeper (model-agnostic via OpenRouter; never selectable in UI)
OPENROUTER_API_KEY=
BOOKKEEPER_MODEL=deepseek/deepseek-chat

# Comma-separated Arc testnet RPC endpoints (spread indexer load; primary first)
RPC_URLS=https://rpc.testnet.arc.network

# Tx pacing in ms (public RPC quota mitigation)
TX_PACE_MS=1200
